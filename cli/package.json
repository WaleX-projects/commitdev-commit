{
  "name": "commitdev",
  "version": "0.1.0",
  "description": "Turn tagged git commits into social posts. Git + GitHub + Supabase + Bombshell.",
  "type": "module",
  "bin": { "cdv": "./dist/commitdev.js" },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=node --outfile=dist/commitdev.js --banner='#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bomb.sh/args": "^0.3.1",
    "@clack/prompts": "^1.7.0",
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
